{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "LiveChat": {
    "BufferCapacity": 500,
    "DeduplicationCapacity": 2000,
    "MaxMessageLength": 4000,
    "MaxProviderEventIdLength": 512,
    "MaxChannelIdLength": 512,
    "MaxUserIdLength": 512,
    "MaxTextFieldLength": 512,
    "MaxBadges": 32,
    "MaxBadgeLength": 128,
